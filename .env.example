# Compose-scope secrets (copy to .env — gitignored). docker-compose reads ONLY
# this file (and the shell) for ${...} interpolation; backend/.env is a separate
# scope used by the FastAPI monolith + `dapr run` flow.
#
# Sidecar->app authentication for history-service's event-ingestion endpoints
# (/events/*). Required — compose refuses to start history without it:
#   openssl rand -hex 16
APP_API_TOKEN=

# Optional learned matcher for the compose stack. CONTAINER path — data/models/
# is mounted read-only at /store/models, so e.g. /store/models/matcher_logistic_v2.json.
# Blank = deterministic formula. (backend/.env's MATCHER_MODEL_PATH never reaches
# compose — interpolation scope — and the checked-in v1 artifact is refused by the
# current feature layout anyway; retrain first, see docs/matching-rework-plan.md.)
MATCHER_MODEL_PATH=
