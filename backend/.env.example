# FastAPI career-discovery API configuration (placeholders — no real secrets).

# Path to the ChromaDB store built by data/scripts/build_rag.py.
# Relative paths resolve against the repo root by default; override if you copied it.
CHROMA_PATH=../data/jobs/chroma
CHROMA_COLLECTION=job_ads

# Embedding model — MUST match the one used to build the store.
EMBED_MODEL=all-MiniLM-L6-v2

# How many job ads to retrieve per career field when scoring.
RAG_TOP_K=8

# Learned matcher artifact from data/scripts/export_model.py (optional).
# Leave blank to score with the deterministic formula (also the automatic fallback
# on any model load/inference error). NOTE: the checked-in artifact
# (../data/models/matcher_logistic_v1.json) was trained on the old 6-career
# catalog (features-v1) and is REJECTED by the current features-v3 layout —
# retrain via the pipeline in docs/matching-rework-plan.md before setting this.
# The artifact is trained on synthetic LLM-panel silver labels — prototype
# quality, not expert-validated.
# Relative paths resolve against the uvicorn working directory (backend/).
MATCHER_MODEL_PATH=

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

API_PORT=8000
LOG_LEVEL=INFO

# Supabase — auth (GoTrue + user_profiles) and job_postings reads. Leave blank to
# disable (auth routes then 503). SUPABASE_SERVICE_KEY is the service_role key:
# server-only, full DB access, bypasses RLS. NEVER expose it to the browser and
# NEVER commit the real value (put it in backend/.env).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Dapr sidecar (DEV-38) — state store (submissions, roadmap progress) and pub/sub.
# false = persistence is a no-op and progress/history return 503, exactly like the
# old Supabase-off mode. Set true and run under `dapr run` (see docs/dapr.md).
# DAPR_HTTP_PORT is exported automatically by `dapr run`; the names below must
# match the component files in dapr/components/.
DAPR_ENABLED=false
DAPR_STATE_STORE=statestore
DAPR_PUBSUB=pubsub
# Dapr auth, two independent directions (both read as `dapr-api-token` headers):
# APP_API_TOKEN  (sidecar -> app): daprd sends it on every delivery; /events/* +
#   /dapr/* reject requests without it. Blank = open (dev only, uvicorn binds
#   localhost). Required when the app binds 0.0.0.0 — e.g. `openssl rand -hex 16`.
#   NOTE this file only feeds the monolith `dapr run` flow; docker-compose reads
#   APP_API_TOKEN from the REPO-ROOT .env instead (compose interpolation scope).
# DAPR_API_TOKEN (app -> sidecar): when daprd requires API auth, the backend
#   attaches this to every state/publish call. Blank when the sidecar is open.
APP_API_TOKEN=
DAPR_API_TOKEN=

# OpenAI — used to generate personalized roadmaps. Leave blank to disable (roadmaps
# then fall back to the curated static data/roadmaps.json).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Job-ad requirement enrichment (DEV-59). Per career field, skills mined from the job
# ads are classified by how often they appear across that field's ads:
#   Required  = skill in >= REQUIREMENTS_REQUIRED_RATIO of the sampled ads
#   Advantage = skill in [REQUIREMENTS_ADVANTAGE_RATIO, REQUIREMENTS_REQUIRED_RATIO)
REQUIREMENTS_REQUIRED_RATIO=0.4
REQUIREMENTS_ADVANTAGE_RATIO=0.15
REQUIREMENTS_SAMPLE_SIZE=100     # max ads sampled per field (the % denominator)
REQUIREMENTS_MIN_ADS=8           # below this, skip — the % would be unreliable
REQUIREMENTS_MAX_PER_BUCKET=6    # cap items per Required/Advantage bucket
